# GitHub asset repo (must already be a git repo you can push to)
GITHUB_USER=thisisbremlo
GITHUB_REPO=savault-assets
GITHUB_BRANCH=main

# Local path to the cloned savault-assets repo
ASSET_REPO_DIR=../savault-assets

# UTM tags added to outbound links
UTM_SOURCE=savault.de
UTM_MEDIUM=referral

# Notion integration (for the "Add to Notion" button)
# Create at https://www.notion.so/my-integrations, then share your
# database with that integration (Database -> "..." -> Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Local server port
PORT=3000

# Archive worker (Cloudflare Worker that mirrors Notion into KV for the
# Chrome extension). After pushing to Notion/GitHub this tool calls the
# worker's POST /api/refresh so the extension sees new entries immediately
# instead of waiting for the worker's cron tick. SAVAULT_API_KEY must match
# the worker's SAVAULT_API_KEY secret. Leave empty to skip the refresh call.
SAVAULT_WORKER_URL=
SAVAULT_API_KEY=

# Optional: use a locally installed Chromium instead of the Playwright download
# (e.g. when the Playwright CDN is blocked). Leave empty for default behavior.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
